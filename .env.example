# Copy this file to .env and fill in the keys you want to use.
# Keep .env private. Do not commit real API keys.

# SEC EDGAR does not need an API key, but SEC asks automated clients to declare
# a descriptive User-Agent with contact information.
SEC_USER_AGENT="stock-recommender/0.1 your-email@example.com"

# Optional. Defaults to Asia/Seoul and controls snapshot/report dates.
STOCK_RECOMMENDER_TIMEZONE="Asia/Seoul"

# Optional. Defaults to snapshot_store/recommendation_snapshots.json.
# GitHub Actions writes compact rows here when STOCK_RECOMMENDER_PERSIST_REPO_LEDGER=1.
STOCK_RECOMMENDER_SNAPSHOT_STORE_PATH=""

# Optional. Local runs keep full snapshots in SQLite only by default.
# Set this to an ignored directory such as artifacts/snapshots to also write full JSON artifacts.
STOCK_RECOMMENDER_FULL_SNAPSHOT_DIR=""

# Optional. Keep false/empty locally. GitHub Actions sets this to 1 before committing the compact ledger.
STOCK_RECOMMENDER_PERSIST_REPO_LEDGER=""

# Optional. Use screened for real listed-company candidates, curated for the old 31-name debug universe.
STOCK_RECOMMENDER_UNIVERSE_MODE="screened"
STOCK_RECOMMENDER_UNIVERSE_LIMIT="500"
STOCK_RECOMMENDER_US_UNIVERSE_LIMIT="350"
STOCK_RECOMMENDER_KR_UNIVERSE_LIMIT="150"
STOCK_RECOMMENDER_US_FUNDAMENTAL_LIMIT="200"
STOCK_RECOMMENDER_KR_FUNDAMENTAL_LIMIT="30"

# Optional. Required when you want Korean filings/financial statements.
OPENDART_API_KEY=""

# Optional. Required when you want FRED macroeconomic series.
FRED_API_KEY=""

# Optional. Required when you want Bank of Korea ECOS macro series.
ECOS_API_KEY=""

# Optional. More stable price/news APIs can be added later.
POLYGON_API_KEY=""
NEWS_API_KEY=""
